# Meta / Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=replace_with_long_lived_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=replace_with_business_account_id
META_APP_ID=replace_with_meta_app_id
META_APP_SECRET=replace_with_meta_app_secret
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_CACHE_SECONDS=3600

# Optional: if you deploy to Vercel/Netlify/another serverless host
# Copy this file to .env and set the values above before deploying.
